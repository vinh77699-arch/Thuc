# Dán các biến này vào Environment Variables khi tạo Web Service trên render.com
# NODE_VERSION sẽ dùng Node 18 mặc định — không cần thêm
PORT=10000
JWT_SECRET=englishcenter_jwt_secret_2026_change_me
JWT_EXPIRES=7d
# CLIENT_URL = URL Netlify của bạn (ví dụ: https://my-english-center.netlify.app)
# Có thể thêm nhiều URL cách nhau bằng dấu phẩy
CLIENT_URL=https://REPLACE_WITH_YOUR_NETLIFY_URL.netlify.app
